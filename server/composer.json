{
    "name": "openrpa/browsershot-service",
    "description": "Browsershot HTTP Service for HTML to Image conversion",
    "type": "project",
    "require": {
        "php": "^8.2",
        "spatie/browsershot": "^5.4",
        "spatie/temporary-directory": "^2.0",
        "symfony/process": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Spatie\\Browsershot\\": "../src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.28"
        },
        "platform-check": false
    }
}